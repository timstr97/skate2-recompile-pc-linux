+void VulkanCommandProcessor::MaybeSynchronizePresentIdleclean(uint32_t index, uint32_t value) {
+  // Vulkan port of the D3D12 idle-clean synchronization. PM4 register writes
+  // run on the command worker. This is deliberately not a complete WAIT_UNTIL
+  // implementation: do not close partial frames, submissions or queries.
+  if (index != XE_GPU_REG_WAIT_UNTIL || !(value & (UINT32_C(1) << 17)) ||
+      !present_idleclean_sync_enabled_) {
+    return;
+  }
+  auto& stats = present_idleclean_diagnostic_;
+  ++stats.hits;
+  const uint64_t current = GetCurrentSubmission();
+  const uint64_t target = current ? current - 1 : 0;
+  const uint64_t completed_before = submission_completed_;
+  const char* reason = "none";
+  uint32_t skip_bit = 0;
+  if (device_lost_) {
+    reason = "device_lost"; skip_bit = 1u << 0;
+  } else if (current <= 1) {
+    reason = "no_submitted_frame"; skip_bit = 1u << 2;
+  } else if (frame_open_) {
+    reason = "frame_open"; skip_bit = 1u << 3;
+  } else if (submission_open_) {
+    reason = "submission_open"; skip_bit = 1u << 4;
+  } else if (active_occlusion_query_.valid) {
+    reason = "occlusion_query_active"; skip_bit = 1u << 5;
+  } else if (scratch_buffer_used_) {
+    reason = "scratch_buffer_active"; skip_bit = 1u << 6;
+  }
+
+  uint64_t waited_us = 0;
+  uint64_t completed_after = completed_before;
+  bool log_detail = false;
+  if (skip_bit) {
+    ++stats.skipped;
+    for (uint32_t i = 0; i < stats.skipped_by_reason.size(); ++i) {
+      if (skip_bit == (1u << i)) ++stats.skipped_by_reason[i];
+    }
+    log_detail = !(stats.logged_skip_reasons & skip_bit);
+    stats.logged_skip_reasons |= skip_bit;
+  } else {
+    const auto start = std::chrono::steady_clock::now();
+    VkResult wait_result = VK_SUCCESS;
+    const bool already_complete = completed_before >= target;
+    if (!already_complete && !submissions_in_flight_fences_.empty()) {
+      // Bounded wait for every in-flight submission (all are < current since no
+      // submission is open). Never call the general helper with current: it
+      // could close a submission.
+      const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+      const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+      ++stats.wait_calls;
+      wait_result = dfn.vkWaitForFences(
+          vulkan_device->device(), uint32_t(target - completed_before),
+          submissions_in_flight_fences_.data(), VK_TRUE, UINT64_C(5000000000));
+    }
+    if (wait_result == VK_SUCCESS) {
+      // Reclaim fences and resources now that completion is verified. Target 0
+      // never ends a submission because current >= 2.
+      CheckSubmissionFenceAndDeviceLoss(0);
+    }
+    completed_after = submission_completed_;
+    waited_us = uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now() - start).count());
+    stats.waited_us += waited_us;
+    if (wait_result != VK_SUCCESS || device_lost_ || completed_after < target) {
+      ++stats.failed;
+      if (wait_result == VK_ERROR_DEVICE_LOST) device_lost_ = true;
+      REXGPU_ERROR("Present idle-clean diagnostic FAILED: value={:08X} current={} target={} "
+                   "completed_before={} completed_after={} waited_us={} hits={} "
+                   "wait_result={}",
+                   value, current, target, completed_before, completed_after, waited_us,
+                   stats.hits, int32_t(wait_result));
+      rex::FatalError("The optional present idle-clean diagnostic could not verify GPU completion.");
+    }
+    ++stats.synchronized;
+    if (already_complete) ++stats.already_complete;
+    log_detail = stats.synchronized <= 8;
+  }
+  // First eight successes, each skip reason once, and at most thirty periodic
+  // summaries spanning menus and gameplay. No per-frame or unbounded log stream.
+  if (log_detail || (stats.hits <= 18000 && stats.hits % 600 == 0)) {
+    REXGPU_INFO("Present idle-clean diagnostic: value={:08X} current={} target={} "
+                "completed_before={} completed_after={} waited_us={} skipped_reason={} "
+                "hits={} synchronized={} wait_calls={} already_complete={} skipped={} failed={} "
+                "total_waited_us={} skipped_by_reason=[lost:{},empty:{},frame:{},"
+                "submission:{},query:{},scratch:{}]",
+                value, current, target, completed_before, completed_after, waited_us, reason,
+                stats.hits, stats.synchronized, stats.wait_calls, stats.already_complete,
+                stats.skipped, stats.failed, stats.waited_us, stats.skipped_by_reason[0],
+                stats.skipped_by_reason[2], stats.skipped_by_reason[3],
+                stats.skipped_by_reason[4], stats.skipped_by_reason[5],
+                stats.skipped_by_reason[6]);
+  }
+}
